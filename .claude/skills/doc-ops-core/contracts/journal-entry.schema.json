{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-ops-core/journal-entry.schema.json",
  "type": "object",
  "required": ["schemaVersion", "batchDigest", "type"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batchDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "type": { "enum": ["prepared", "observed", "completion"] },
    "actionId": { "type": "string", "minLength": 1 },
    "completionSentinel": { "type": "boolean" }
  },
  "additionalProperties": true
}
