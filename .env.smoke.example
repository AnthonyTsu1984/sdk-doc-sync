# Copy to .env.smoke.local for non-secret smoke target identifiers only.
# Never point these values at production folders, Bases, or tables.
SMOKE_PROFILE=doc-ops-smoke
SMOKE_TENANT_MARKER=DOC_OPS_TEST
SMOKE_FEISHU_HOST=https://open.feishu.cn
SMOKE_IDENTITY_FINGERPRINT=sha256:<sandbox-identity-fingerprint>
SMOKE_ROOT_TOKEN=replace-with-test-root-folder-token
SMOKE_BASE_TOKEN=replace-with-test-base-token
SMOKE_TABLE_ID=replace-with-test-table-id
SMOKE_APP_ID=replace-with-test-app-id

# Do not persist SMOKE_APP_SECRET here. Enter it into the current shell with
# hidden input only when a live adapter needs bot credentials.
