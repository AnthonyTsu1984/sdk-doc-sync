{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilliz.local/contracts/localized-doc-sync/translation-receipt.schema.json",
  "type": "object",
  "required": ["schemaVersion", "translationPairId", "englishDocumentIdentity", "chineseDocumentIdentity", "englishSourceDigest", "chineseTargetDigest", "englishMetaDigest", "chineseMetaDigest", "sourceRevision", "targetRevision", "semanticUnitsDigest", "translationContractDigest", "promptContractDigest", "translatorAdapterVersion", "model", "acceptedExecutionJournalDigest", "acceptedDecisionDigest", "receiptDigest"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "translationPairId": { "type": "string", "pattern": "^translation-pair:" },
    "englishDocumentIdentity": { "type": "object" },
    "chineseDocumentIdentity": { "type": "object" },
    "englishSourceDigest": { "$ref": "#/$defs/digest" },
    "chineseTargetDigest": { "$ref": "#/$defs/digest" },
    "englishMetaDigest": { "$ref": "#/$defs/digest" },
    "chineseMetaDigest": { "$ref": "#/$defs/digest" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "targetRevision": { "type": "string", "minLength": 1 },
    "semanticUnitsDigest": { "$ref": "#/$defs/digest" },
    "translationContractDigest": { "$ref": "#/$defs/digest" },
    "promptContractDigest": { "$ref": "#/$defs/digest" },
    "translatorAdapterVersion": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "acceptedExecutionJournalDigest": { "$ref": "#/$defs/digest" },
    "acceptedDecisionDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
  "additionalProperties": false
}
