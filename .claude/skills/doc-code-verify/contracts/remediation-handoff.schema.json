{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zilliz.com/schemas/doc-code-verify/remediation-handoff.schema.json",
  "title": "Documentation Code Verification Remediation Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "verificationResultDigest", "sourceDigest", "items", "writeAuthorized", "requiresNewActionBatch", "handoffDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "doc-code-remediation-handoff" },
    "verificationResultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "items": { "type": "array", "items": { "type": "object" } },
    "writeAuthorized": { "const": false },
    "requiresNewActionBatch": { "const": true },
    "handoffDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
