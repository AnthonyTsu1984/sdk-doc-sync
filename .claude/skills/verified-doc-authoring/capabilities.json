{
  "schemaVersion": 2,
  "skill": "verified-doc-authoring",
  "mustPreserve": [
    { "id": "authoring.claim-inventory", "description": "Turn references into concrete claims before drafting.", "fixtureIds": ["claim-inventory"] },
    { "id": "authoring.source-grounding", "description": "Verify API shape and behavioral claims against implementation or canonical specs.", "fixtureIds": ["source-grounding"] },
    { "id": "authoring.unresolved-visible", "description": "Keep unverifiable claims visible instead of polishing them into facts.", "fixtureIds": ["unresolved-visible"] },
    { "id": "authoring.preview-refetch", "description": "Dry-run, approve, write, and refetch target changes.", "fixtureIds": ["preview-refetch"] }
  ],
  "mustFix": [
    { "id": "authoring.evidence-contract", "description": "Emit structured source evidence and verification statuses.", "fixtureIds": ["evidence-contract"] },
    { "id": "authoring.result-contract", "description": "Use the shared deterministic result envelope.", "fixtureIds": ["result-contract"] }
  ],
  "forbidden": [
    { "id": "authoring.no-invented-api", "description": "Do not invent methods, fields, defaults, statuses, or outputs.", "fixtureIds": ["source-grounding"] },
    { "id": "authoring.no-hidden-uncertainty", "description": "Do not hide unresolved claims in polished prose.", "fixtureIds": ["unresolved-visible"] }
  ],
  "positiveTriggers": [{ "id": "draft", "prompt": "Draft or substantially revise this technical guide using source evidence." }],
  "negativeTriggers": [{ "id": "verify-only", "prompt": "Only compile the current examples." }],
  "inputContract": { "sources": ["feishu", "url", "markdown", "issue", "source"], "claimInventoryRequired": true },
  "outputContract": { "schemaVersion": 1, "requires": ["evidence", "unresolved", "verification"] },
  "sideEffectPolicy": { "default": "local-draft", "writeRequires": ["dryRun", "approval", "refetch"] },
  "allowedSemanticChanges": ["authoring.evidence-contract", "authoring.result-contract"],
  "reviewPolicy": {
    "unit": "document",
    "gates": ["write", "document-acceptance"],
    "rollback": "pre-finalization"
  },
  "learningPolicy": {
    "captureOutcomes": ["rejected", "changes_requested", "approved", "accepted"],
    "approvalStrength": "weak-positive",
    "highRiskAutomaticPromotion": false
  },
  "adapterPolicy": {
    "operations": [
      {
        "operation": "author",
        "status": "planned",
        "productionEntrypoint": null,
        "focusedTest": null,
        "migrationTask": "Task 11",
        "journalRequiredForWrites": true
      }
    ]
  }
}
