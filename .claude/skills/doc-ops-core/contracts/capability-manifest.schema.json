{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-ops-core/capability-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "skill", "mustPreserve", "mustFix", "forbidden", "positiveTriggers", "negativeTriggers", "inputContract", "outputContract", "sideEffectPolicy", "allowedSemanticChanges", "reviewPolicy", "learningPolicy", "adapterPolicy"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "skill": { "type": "string", "minLength": 1 },
    "mustPreserve": { "$ref": "#/$defs/capabilities" },
    "mustFix": { "$ref": "#/$defs/capabilities" },
    "forbidden": { "$ref": "#/$defs/capabilities" },
    "positiveTriggers": { "type": "array", "minItems": 1 },
    "negativeTriggers": { "type": "array", "minItems": 1 },
    "inputContract": { "type": "object" },
    "outputContract": { "type": "object" },
    "sideEffectPolicy": { "type": "object" },
    "allowedSemanticChanges": { "type": "array" },
    "reviewPolicy": {
      "type": "object",
      "required": ["unit", "gates", "rollback"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "learningPolicy": {
      "type": "object",
      "required": ["captureOutcomes", "approvalStrength", "highRiskAutomaticPromotion"],
      "properties": {
        "captureOutcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["approved", "rejected", "changes_requested", "accepted", "rollback_requested", "rolled_back", "finalized"]
          }
        },
        "approvalStrength": { "type": "string", "minLength": 1 },
        "highRiskAutomaticPromotion": { "const": false }
      }
    },
    "adapterPolicy": {
      "type": "object",
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/adapterOperation" }
        }
      }
    }
  },
  "$defs": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fixtureIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "fixtureIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "adapterOperation": {
      "type": "object",
      "required": ["operation", "status", "journalRequiredForWrites"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "status": { "enum": ["adopted", "partial", "planned"] },
        "productionEntrypoint": { "type": ["string", "null"] },
        "focusedTest": { "type": ["string", "null"] },
        "migrationTask": { "type": "string", "pattern": "^Task [0-9]+$" },
        "journalRequiredForWrites": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "required": ["status"], "properties": { "status": { "enum": ["adopted", "partial"] } } },
          "then": { "required": ["productionEntrypoint", "focusedTest"] }
        },
        {
          "if": { "required": ["status"], "properties": { "status": { "const": "planned" } } },
          "then": { "required": ["migrationTask"] }
        }
      ]
    }
  }
}
