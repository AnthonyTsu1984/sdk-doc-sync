{
  "profileVersion": 1,
  "comment": "每日扫描哨兵的唯一语言事实源（批 17）。六脚本/ledger SENTINELS/cron 提示词三处重复归此处。displayName/noTagSuffix/prSectionName/reportTitle 为批 17 实现追加的呈现层字段：六份 py 脚本的报告措辞在四个名字上并不统一（go 的 fetch/无变化行用 repos/milvus-sdk-go、PR 节用 milvus-sdk-go；python 用 pymilvus），为逐字保留而入数据，不入代码。",
  "shared": {
    "webContentRepo": "milvus-io/web-content",
    "webContentDir": "../web-content",
    "prListLimit": 30,
    "artifactsDir": "tmp/sdk-release-scout/daily",
    "findingsLedgerPath": "tmp/api-reference-sync/daily-scan/pr-findings.jsonl",
    "scanStatePath": ".claude/skills/api-reference-sync/scan-state.json",
    "scoutCli": ".claude/skills/api-reference-sync/bin/sdk-release-scout.js"
  },
  "languages": {
    "cpp": {
      "sdkDir": "repos/milvus-sdk-cpp",
      "sdkName": "milvus-sdk-cpp",
      "webContentPathPrefix": "API_Reference/milvus-sdk-cpp/",
      "reportName": "{date}.md",
      "reportTitle": "C++ SDK",
      "displayName": "milvus-sdk-cpp",
      "prSectionName": "milvus-sdk-cpp",
      "noTagSuffix": "两轨道均无新 tag",
      "tracks": [
        { "version": "v2.6.x", "scanStateKey": "cpp-v26", "artifactKey": "cpp-v26", "preReleaseBelowRelease": true },
        { "version": "v3.0.x", "scanStateKey": "cpp-v30", "artifactKey": "cpp-v30", "preReleaseBelowRelease": true }
      ],
      "identityMaps": ["cpp-v26.json", "cpp-v30.json"],
      "extraIgnoreRules": [],
      "notes": []
    },
    "go": {
      "sdkDir": "repos/milvus-sdk-go",
