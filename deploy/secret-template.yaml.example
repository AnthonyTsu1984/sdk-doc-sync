# deploy/secret-template.yaml.example — secret sdk-env 的形态示例。
#
# 红线：真值永不入库。本文件只有占位符，展示键名集合；实际创建不用本文件，
# 一律（在仓库根、.env 已就位时）：
#
#   kubectl create secret generic sdk-env --from-env-file=.env -n sdk-doc-sync
#
# .env 已被 .gitignore 忽略（真值不出盘上明文 git 面）。键名与仓库 .env 实测
# 全集一致（grep '^[A-Z_0-9]+=' .env，2026-10-24）；pod 只消费其中一部分
# （LLM_*/GITHUB_TOKEN/BOT_*/DOC_*/FEISHU_HOST/OPERATOR_EMAIL），其余键随
# envFrom 全量注入，无害且省一次裁剪决策。
#
# 注意：secret 更新不会自动进已运行容器——更新后需滚动重启：
#   kubectl -n sdk-doc-sync rollout restart deploy/python-worker deploy/java-worker
apiVersion: v1
kind: Secret
metadata:
  name: sdk-env
  namespace: sdk-doc-sync
type: Opaque
stringData:
  # ---- LLM 提供方（openai-compatible；opencode.json {env:} 插值来源） ----
  LLM_BASE_URL: "REPLACE_ME"            # 例：https://token.example.com
  LLM_API_KEY: "REPLACE_ME"
  LLM_MODEL: "REPLACE_ME"               # 例：deepseek-v4.1-flash（models 键写死用它）
  # ---- GitHub（gh CLI 免登录走 GH_TOKEN=此值；anonymous clone 之外的一切 gh 调用） ----
  GITHUB_TOKEN: "REPLACE_ME"
  # ---- 飞书消息应用（BOT_*：门铃卡片通知；im/v1/messages + tenant_access_token） ----
  BOT_APP_ID: "REPLACE_ME"
  BOT_APP_SECRET: "REPLACE_ME"
  BOT_FEISHU_EVENT_VERIFICATION_TOKEN: "REPLACE_ME"   # pod 不消费，随 envFrom 注入
  BOT_FEISHU_EVENT_ENCRYPT_KEY: "REPLACE_ME"          # 同上
  # ---- 飞书文档应用（DOC_*：战役 worker 走 Bitable/Drive 写入时用） ----
  DOC_APP_ID: "REPLACE_ME"
  DOC_APP_SECRET: "REPLACE_ME"
  # ---- 站点与操作员（门铃卡片 p2p open_id 由 OPERATOR_EMAIL 求解并缓存） ----
  FEISHU_HOST: "REPLACE_ME"             # 例：https://open.feishu.cn
  OPERATOR_EMAIL: "REPLACE_ME"
  # ---- 以下键 pod 不消费，随 envFrom 注入保持与 .env 同形 ----
  WIKI_SPACE_ID: "REPLACE_ME"
  FIGMA_API_KEY: "REPLACE_ME"
  AWS_ACCESS_KEY: "REPLACE_ME"
  AWS_ACCESS_SECRET_KEY: "REPLACE_ME"
  AWS_S3_BUCKET: "REPLACE_ME"
  ZILLIZ_CLOUD_UAT_API_KEY: "REPLACE_ME"
  ZILLIZ_CLOUD_UAT_HOST_ADDR: "REPLACE_ME"
